int firstUnicode = 0;
int lastUnicode = 0;

PFont myFont;
PrintWriter logOutput;

void openFontFolder(String folderPath) {
  try {
    String os = System.getProperty("os.name").toLowerCase();
    if (os.contains("mac")) {
      Runtime.getRuntime().exec(new String[] { "open", folderPath });
    } else if (os.contains("win")) {
      Runtime.getRuntime().exec(new String[] { "cmd", "/c", "start", "", folderPath });
    } else {
      Runtime.getRuntime().exec(new String[] { "xdg-open", folderPath });
    }
  } catch (IOException e) {
    println("Could not open folder: " + folderPath);
  }
}

void setup() {
  logOutput = createWriter("FontFiles/System_Font_List.txt");
  size(1000, 800);

  String[] fontList = PFont.list();
  printArray(fontList);

  for (int x = 0; x < fontList.length; x++) {
    logOutput.print("[" + x + "] ");
    logOutput.println(fontList[x]);
  }
  logOutput.flush();
  logOutput.close();

  if (fontNumber >= 0) {
    fontType = "";
  }

  println();
  println("=====================");
  println("Creating font files...");
  println("Main unicodes (10/12)    = " + specificUnicodes.length);
  println("Detail unicodes (6)     = " + detailUnicodes.length);
  println("Large unicodes (18)     = " + largeUnicodes.length);

  boolean smooth = true;
  char[] previewCharset = buildCharset(specificUnicodes);
  myFont = createFont(fontName + fontType, displayFontSize, smooth, previewCharset);

  fill(0, 0, 0);
  textFont(myFont);

  int margin = displayFontSize;
  translate(margin / 2, margin);

  int gapx = displayFontSize * 10 / 8;
  int gapy = displayFontSize * 10 / 8;
  int index = 0;
  int count = previewCharset.length;
  fill(0);
  textSize(displayFontSize);

  for (int y = 0; y < height - gapy; y += gapy) {
    int x = 0;
    while (x < width) {
      int unicode = previewCharset[index];
      float cwidth = textWidth((char)unicode) + 2;
      if ((x + cwidth) > (width - gapx)) break;

      text(new String(Character.toChars(unicode)), x, y);
      x += cwidth;
      index++;
      if (index >= count) break;
    }
    if (index >= count) break;
  }

  for (int s = 0; s < fontSizes.length; s++) {
    int fontSize = fontSizes[s];
    // 6pt 擴充常用字；18pt 僅溫度數字；其餘精簡字集
    int[] source = specificUnicodes;
    if (fontSize == 6) {
      source = detailUnicodes;
    } else if (fontSize == 18) {
      source = largeUnicodes;
    }
    char[] charset = buildCharset(source);
    println("Size " + fontSize + " charset = " + charset.length);

    PFont font = createFont(fontName + fontType, fontSize, smooth, charset);
    println("Created font " + outputFontName + str(fontSize) + ".vlw");

    String fontFileName = "FontFiles/" + outputFontName + str(fontSize) + ".vlw";

    try {
      print("Saving " + fontFileName + "... ");
      OutputStream output = createOutput(fontFileName);
      font.save(output);
      output.close();
      println("OK!");
    } catch (IOException e) {
      println("Failed to create " + fontFileName);
    }

    if (!createHeaderFile) {
      continue;
    }

    try {
      print("saving header for size " + fontSize + "...");
      InputStream input = createInputRaw(fontFileName);
      PrintWriter output = createWriter("FontFiles/" + outputFontName + str(fontSize) + ".h");

      output.println("#include <pgmspace.h>");
      output.println();
      output.println("const uint8_t " + outputFontName + str(fontSize) + "[] PROGMEM = {");

      int i = 0;
      int data = input.read();
      while (data != -1) {
        output.print("0x");
        output.print(hex(data, 2));
        if (i++ < 15) {
          output.print(", ");
        } else {
          output.println(",");
          i = 0;
        }
        data = input.read();
      }
      output.println("\n};");
      output.close();
      input.close();
      println("C header file created.");
    } catch (IOException e) {
      println("Failed to create C header file for size " + fontSize);
    }
  }

  delay(100);
  String path = sketchPath();
  if (openFolder) {
    openFontFolder(path + "/FontFiles");
    println("Font folder: " + path + "/FontFiles");
  }
  System.err.println("All done! Generated sizes: 6 / 10 / 12 / 18. Note: Rectangles are displayed for non-existant characters.");
}

char[] buildCharset(int[] specific) {
  int blockCount = unicodeBlocks.length;
  int count = specific.length;
  for (int i = 0; i < blockCount; i += 2) {
    int first = unicodeBlocks[i];
    int last = unicodeBlocks[i + 1];
    if (last < first) {
      continue;
    }
    count += (last - first + 1);
  }

  char[] charset = new char[count];
  int index = 0;
  for (int i = 0; i < blockCount; i += 2) {
    int first = unicodeBlocks[i];
    int last = unicodeBlocks[i + 1];
    for (int code = first; code <= last; code++) {
      charset[index++] = Character.toChars(code)[0];
    }
  }
  for (int i = 0; i < specific.length; i++) {
    charset[index++] = Character.toChars(specific[i])[0];
  }
  return charset;
}
